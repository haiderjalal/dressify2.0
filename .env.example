# ─── Core ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:your-local-password@localhost:5432/dressify
# Max DB connections per app instance (keep small on serverless; use a pooler like PgBouncer/Neon pooler)
DATABASE_POOL_MAX=10
# 32+ random characters: `openssl rand -base64 48`
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─── Payments ────────────────────────────────────────────────────────
# "test" routes Easypaisa and Card payments to the built-in test gateway.
# Switch to "live" only after adding merchant credentials below.
PAYMENTS_MODE=test
PAYMENT_WEBHOOK_SECRET=change-me-another-long-random-string
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_CHECKOUT_URL=https://easypay.easypaisa.com.pk/easypay/Index.jsf
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=sandbox

# ─── Web push notifications (generate with: npm run vapid) ───────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@dressify.pk

# ─── Realtime chat (optional; without it chat polls every few seconds) ─
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ─── Redis cache + rate limiting (optional; Upstash REST) ────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── File storage (optional; without it files go to public/uploads) ──
# Works with Cloudflare R2, AWS S3, or any S3-compatible storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL where uploaded files are served (e.g. https://cdn.dressify.pk)
S3_PUBLIC_URL=

# ─── Maps ────────────────────────────────────────────────────────────
# OpenStreetMap tiles by default. For high traffic use a tile provider (MapTiler, Stadia, etc.)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# ─── Cron (protects /api/cron/* endpoints) ───────────────────────────
CRON_SECRET=change-me-cron-secret

# Show demo logins on the sign-in page (remove in production)
SHOW_DEMO_ACCOUNTS=1

# Camera try-on body-tracking model (self-host it on your CDN for production)
NEXT_PUBLIC_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task
