{
  "name": "dressify",
  "version": "1.0.0",
  "private": true,
  "description": "Dressify — connects customers with tailors. Next.js marketplace with tailor dashboard and admin.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/server/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "vapid": "web-push generate-vapid-keys",
    "test": "vitest run",
    "test:workshop": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.workshop.config.ts",
    "postinstall": "node scripts/copy-mediapipe.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@node-rs/argon2": "^2.2.2",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
